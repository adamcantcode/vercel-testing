{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev --port 3333",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schemas extract --enforce-required-fields --force --path ./schema.json && sanity typegen generate",
    "seed": "sanity exec scripts/seed.ts --with-user-token"
  },
  "dependencies": {
    "@sanity/document-internationalization": "^6.2.38",
    "@sanity/icons": "^5.2.2",
    "@sanity/vision": "6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.16.0",
    "sanity-plugin-internationalized-array": "^5.3.1",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@sanity/client": "^8.8.0",
    "@types/react": "^19",
    "typescript": "^5"
  }
}
